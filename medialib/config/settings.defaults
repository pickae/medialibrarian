# The values a setting has when neither the environment nor the user's settings
# file (~/.config/medialib/settings) gives one. Same format as that file; only
# the settings whose default is a value rather than "unset" are here. Every
# command reads these beneath whatever the user set, and docs/settings.md
# prints them as the defaults.

# The languages you speak, in the order subtitles are fetched for them.
spokenLanguages=en,de,fr,nl,es,it

# The languages an improved copy keeps beside the film's own.
keepLanguages=en

# --- reading books aloud
narrationFormat=m4b
narrationChannel=mono
# The GPU memory, in GB, each book read at once is sized for.
narrationVramPerBookGB=5
narrationEngineLanguages=xtts:ara,ces,deu,eng,fra,hin,hun,ita,jpn,kor,nld,pol,por,rus,spa,tur,zho
narrationPythonMinMinor=10
narrationPythonMaxMinor=12
narrationTorchcodecPairs="2.9:0.9 2.10:0.10 2.11:0.11 2.13:0.15 2.14:0.17"
narrationProgressTail=65536
narrationLosslessTolerance=0.02
narrationVoiceFallbackNames="default any fallback other"
voiceSampleMaxSeconds=60
voiceSampleSearchSeconds=180
voiceSampleSeconds=45
voiceSampleMinSeconds=5
voiceSampleMaxGap=2.5
voiceSilenceNoise=-30dB
voiceSilenceMinDur=0.3
voiceSampleRate=24000
voiceSampleCodec=pcm_s16le
