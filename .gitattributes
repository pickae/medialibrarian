# Line endings are pinned, they are not a matter of taste here.
#
# These scripts are edited on both a Linux and a Windows machine and run by bash
# on both. Bash treats a carriage return as part of the word it follows, so a
# script saved with CRLF does not merely look odd - it does not run at all: its
# shebang names an interpreter called "/bin/bash\r", and every "then" is
# "then\r". ytdlp.sh and lib/podcastFeeds.bash were committed that way once and
# could not be executed on Linux until they were converted back.
#
# The feed tables are here for the same reason from the other side: a row is
# tab-separated and its last column is a URL, so a stray carriage return ends up
# inside the address.
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.tsv   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf

# The tool stub is the third bash script and the rules above do not reach it: it
# carries neither suffix ON PURPOSE, which is the thing tests/test_paths_in_prose
# asserts about, so it needs its own line rather than a rename.
tests/data/toolstub             text eol=lf

# The recorded fixtures, which are compared BYTE for byte against what a command
# prints. None of these suffixes were pinned, so the bytes in the repository were
# whatever core.autocrlf the committing machine happened to have - and a fixture
# checked out with CRLF differs from the run on every line, on a host whose own
# checkout is the innocent one. Enumerated, and under tests/data only, so a real
# media fixture added later is not silently converted along with them.
tests/data/**/*.out             text eol=lf
tests/data/**/*.err             text eol=lf
tests/data/**/*.rc              text eol=lf
tests/data/**/*.tree            text eol=lf
tests/data/**/*.cue             text eol=lf
tests/data/**/*.chapters        text eol=lf
tests/data/**/*.srt             text eol=lf
